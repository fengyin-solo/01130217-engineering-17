# 复制为 .env.development / .env.production 后按需修改

# 接口地址（开发环境由 vite proxy 转发，生产可填完整域名）
VITE_API_BASE_URL=/api
# 健康检查地址
VITE_HEALTH_URL=/api/health
VITE_HEALTH_TIMEOUT=5000
# 健康状态轮询间隔（毫秒），0 表示只在进入时探测一次
VITE_HEALTH_INTERVAL=30000

# Mapbox：留空则驾驶舱地图自动降级为静态示意图
VITE_MAP_ENABLED=true
VITE_MAPBOX_TOKEN=
VITE_MAP_STYLE=mapbox://styles/mapbox/light-v11
VITE_MAP_LOAD_TIMEOUT=8000

# 数据刷新间隔（毫秒），0 表示不自动刷新
VITE_DASHBOARD_REFRESH_INTERVAL=30000
VITE_DRILLING_REFRESH_INTERVAL=2000
