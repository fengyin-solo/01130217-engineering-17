{
  "name": "well-management-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:only": "vite build",
    "verify:lifecycle": "esbuild scripts/verify-lifecycle.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/verify-lifecycle.mjs --log-level=warning && node node_modules/.cache/verify-lifecycle.mjs",
    "healthcheck": "node scripts/healthcheck.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.16.1",
    "echarts": "^5.4.3",
    "element-plus": "^2.5.0",
    "mapbox-gl": "^3.23.1",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.5.0",
    "esbuild": "^0.21.5",
    "jsdom": "^29.1.1",
    "sass": "^1.69.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.2.12"
  }
}
